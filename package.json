{
  "name": "@xiezuo/plugin-icon-library",
  "version": "2.0.1",
  "displayName": "扩展图标库",
  "displayName.zh-CN": "扩展图标库",
  "displayName.en-US": "Extended Icon Library",
  "description": "为 NocoBase 提供扩展图标、中文搜索、SVG 导入及颜色和大小设置。",
  "description.zh-CN": "为 NocoBase 提供扩展图标、中文搜索、SVG 导入及颜色和大小设置。",
  "description.en-US": "Extended icons, Chinese search, SVG imports, and color and size settings for NocoBase.",
  "keywords": [
    "nocobase-plugin",
    "icons",
    "icon-picker",
    "menu",
    "ui"
  ],
  "author": {
    "name": "偕作BIM",
    "url": "https://www.xzbim.cn"
  },
  "contributors": [
    {
      "name": "偕作BIM",
      "url": "https://www.xzbim.cn"
    }
  ],
  "maintainers": [
    {
      "name": "偕作BIM",
      "url": "https://www.xzbim.cn"
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/charce526/plugin-icon-library#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charce526/plugin-icon-library.git"
  },
  "main": "./dist/server/index.js",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "client.js",
    "server.js",
    "client.d.ts",
    "client-v2.js",
    "client-v2.d.ts",
    "server.d.ts",
    "dist/**/*.d.ts",
    "README_EN.md",
    "CHANGELOG.md",
    "LICENSE-THIRD-PARTY"
  ],
  "nocobase": {
    "defaultEnabled": false,
    "supportedVersions": [
      ">=2.2.0 <3.0.0"
    ],
    "editionLevel": 0
  },
  "scripts": {
    "postbuild": "node scripts/generate-keywords.cjs --check && node scripts/check-keywords.cjs && node scripts/sync-node-modules.js"
  },
  "devDependencies": {
    "lucide-react": "0.544.0"
  },
  "peerDependencies": {
    "@nocobase/client": ">=2.2.0 <3.0.0",
    "@nocobase/client-v2": ">=2.2.0 <3.0.0",
    "@nocobase/server": ">=2.2.0 <3.0.0",
    "@nocobase/database": ">=2.2.0 <3.0.0"
  }
}
